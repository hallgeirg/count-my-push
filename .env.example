# Local API (Vite proxies /api → port 3000):
# 1) Link once: pnpm vercel:link (pick team + existing/new project; do not interrupt mid-prompt)
#    Or quick new project under default team: pnpm vercel:link:quick
# 2) Sync env: vercel env pull .env.local
# 3) Terminal A: pnpm dev:api   Terminal B: pnpm dev
#
# Production (e.g. https://count.godtgrunnlag.no/): set DATABASE_URL on the Vercel project
# for Production and Preview, then run db/001_init.sql once in Neon.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
